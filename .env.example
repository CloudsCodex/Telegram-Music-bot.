# Developer by : Mr_Manas_Op
# Copy this file to .env and fill in your own values. Never commit .env.

# --- Required -----------------------------------------------------------
# From https://my.telegram.org  (API development tools)
API_ID=
API_HASH=
# From @BotFather
BOT_TOKEN=
# Session string of the dedicated assistant account (run: python generate_session.py)
SESSION_STRING=

# --- Optional -----------------------------------------------------------
# Comma separated numeric Telegram user IDs that receive error notifications
OWNER_IDS=
# Free client id from https://devportal.jamendo.com  (enables song search / plain-text /play)
JAMENDO_CLIENT_ID=

# Paths (defaults shown)
# DATA_DIR=data
# DATABASE_PATH=data/music.db
# DOWNLOAD_DIR=data/downloads
# LOG_DIR=logs
# LOG_LEVEL=INFO

# Limits (defaults shown)
# MAX_QUEUE=50
# MAX_DURATION_MINUTES=180
# MAX_FILE_MB=100
# RATE_LIMIT_COUNT=6
# RATE_LIMIT_WINDOW=10

# Set to false to disable /play <direct link> and /vplay <direct link>
# ALLOW_DIRECT_URLS=true
